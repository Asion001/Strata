# Long random string; encrypts connection credentials. Never change it after setup.
STRATA_SECRET_KEY=
# First admin, created only when the database has no users.
STRATA_ADMIN_USER=admin
STRATA_ADMIN_PASSWORD=
# Set to false only when serving over plain HTTP.
STRATA_COOKIE_SECURE=true
# Optional:
# STRATA_LOCAL_BASE=/data           # root for "local folder" connections (image default)
# STRATA_DATA_DIR=/var/lib/strata   # server state, outside the base (image default)
# STRATA_DEFAULT_STORE=blobs        # private user roots (hashed), below the base
# STRATA_FILES_DIR=files            # the "Server files" connection, below the base
# STRATA_GC_GRACE_HOURS=24
# STRATA_RAW_TTL_SECS=30
# STRATA_TRASH_DAYS=30              # 0 turns the trash off (deletes are permanent)
POSTGRES_PASSWORD=
